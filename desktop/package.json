{
  "name": "kunduz-course-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "سیستم مدیریت کورس‌های پوهنتون کندوز",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "setup": "node src/setup.js",
    "start:server": "node src/server.js",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux dir"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.8",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "supertest": "^7.1.4"
  },
  "build": {
    "appId": "af.edu.kunduz.courses",
    "productName": "Hamrah Mohasel",
    "asar": true,
    "files": [
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "templates/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "public/assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hamrah Mohasel",
      "artifactName": "Hamrah-Mohasel-Setup-${version}.${ext}",
      "script": "electron/installer.nsi",
      "installerLanguages": [
        "fa_IR"
      ],
      "installerIcon": "public/assets/app-icon.ico",
      "uninstallerIcon": "public/assets/app-icon.ico"
    },
    "publish": []
  },
  "author": "Kunduz University - Student Services",
  "license": "UNLICENSED"
}
